# .env.example  (copy to .env.local, and add the same values in Vercel > Settings > Environment Variables)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase > Project Settings > API > service_role key. SERVER ONLY - never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Any random string, 32+ chars (e.g. run: openssl rand -base64 32)
SESSION_SECRET=
# HR password for the HR area (/admin)
ADMIN_PASSWORD=
# Owner password: full HR access + approves HR policy changes + the only key to the developer menu. Must differ from ADMIN_PASSWORD
OWNER_PASSWORD=
# Owner inbox for "HR wants to change leave policy" approval emails
OWNER_EMAIL=
# Public URL of the deployed app (used in email links), e.g. https://attendance.vercel.app
APP_URL=
# Gmail used to SEND emails. Needs 2-Step Verification, then Google Account > Security > App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# HR inbox(es) that receive leave requests + daily "who didn't punch" digest (can also be set in /admin/employees > Settings)
HR_EMAIL=
# Random string; Vercel Cron sends it automatically so only Vercel can trigger reminders
CRON_SECRET=
